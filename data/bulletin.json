          "fontSize": "xlarge",
          "height": 120,
          "bgColor": "#002244",
          "textColor": "#00ffcc"
        },
        {
          "text": "Serving your community{linef}since the dial-up era",
          "align": "center",
          "fontSize": "medium",
          "height": 90,
          "bgColor": "#000000",
          "textColor": "#ffffff"
        },
        {
          "text": "Today is {date}{tab}Current time: {time}",
